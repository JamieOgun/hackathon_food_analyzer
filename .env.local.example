# Which vision provider to call. Defaults to claude if unset.
VISION_PROVIDER=claude

# Needed when VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-sonnet-5

# Needed when VISION_PROVIDER=gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY also works as a fallback if that's what you already have set.
GEMINI_MODEL=gemini-3.8-flash
