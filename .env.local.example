# Gemini is the default image-analysis provider.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY also works as a fallback if that's what you already have set.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Optional Claude fallback: set VISION_PROVIDER=claude to use it.
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-sonnet-5
